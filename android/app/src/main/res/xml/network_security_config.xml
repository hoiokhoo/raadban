<?xml version="1.0" encoding="utf-8"?>
<network-security-config>
    <!-- اجازهٔ http برای نشانی‌های محلی/خانگی (مثل http://192.168.x.x:3000) -->
    <base-config cleartextTrafficPermitted="true">
        <trust-anchors>
            <certificates src="system" />
        </trust-anchors>
    </base-config>
</network-security-config>
